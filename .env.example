DATABASE_URL="file:./dev.db"
# AI provider: mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Integrations: mock | real (real needs credentials, see README)
INTEGRATIONS_MODE=mock
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
META_AD_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=change-me

# Security
# Owner login. With no password the app is open in development and LOCKED in production.
OWNER_PASSWORD=
# Optional: separate secret used to sign login cookies (defaults to the password)
AUTH_SECRET=
# Meta app secret: webhooks must carry a valid X-Hub-Signature-256 when this is set (required in real mode)
META_APP_SECRET=
# Required to call POST /api/cron from an external scheduler (send as "Authorization: Bearer <secret>")
CRON_SECRET=

# WhatsApp marketing broadcasts must use an approved template with ONE body variable {{1}}
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Local free AI via Ollama: set AI_PROVIDER=ollama and OLLAMA_MODEL (after `ollama pull <model>`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
